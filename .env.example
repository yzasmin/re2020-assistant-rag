# Copier ce fichier en .env si vous voulez changer les valeurs par défaut.
# Aucune clé d'API n'est nécessaire : la génération tourne en local avec Ollama.

# Modèle de génération et de jugement (doit être téléchargé : ollama pull <modele>)
OLLAMA_MODEL=qwen2.5:1.5b-instruct-q4_K_M

# Adresse du serveur Ollama
OLLAMA_HOST=http://localhost:11434
