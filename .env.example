# Copier ce fichier en .env et renseigner la clé. Le fichier .env n'est jamais commité.
ANTHROPIC_API_KEY=sk-ant-...

# Obligatoire si la clé n'est pas rattachée à un espace de travail (sinon l'API répond
# « This API key is not scoped to a workspace »). Identifiant visible dans la console Anthropic.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# Optionnel : remplacer les modèles par défaut (agent économique, juge plus capable)
# RE2020_AGENT_MODEL=claude-haiku-4-5
# RE2020_JUDGE_MODEL=claude-sonnet-5
